# Copy to .env and fill in. Never commit .env.

# listmonk REST API (a read-only API user: Admin -> Users -> API user with campaigns:get, campaigns:get_analytics, lists:get)
LM_URL=https://listmonk.example.com
LM_USER=dashboard
LM_TOKEN=

# listmonk's Postgres (read-only access is enough)
LISTMONK_PG_HOST=db.example.com
LISTMONK_PORT=5432
LISTMONK_USER=postgres
LISTMONK_DATABASE=listmonk
LISTMONK_PGPASSWORD=
